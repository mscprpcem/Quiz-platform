# =====================================================================
# MSC QUIZ PLATFORM & VERIFICATION PORTAL CROSS-SYNC ENV VARIABLES
# =====================================================================

# 1. Backend Server Configuration (backend/.env)
PORT=5000
NODE_ENV=production

# Database Connection (Neon PostgreSQL or SQLite)
# If DATABASE_URL is not set, SQLite (database.sqlite) is used locally by default
DATABASE_URL=postgresql://user:password@ep-sample-pooler.neon.tech/msc_quiz?sslmode=require
DB_SSL_REJECT_UNAUTHORIZED=true

# JWT Secret for local admin and student authentication sessions (Minimum 256-bit random secret)
JWT_SECRET=your_super_secret_jwt_key_2026

# Single Sign-On (SSO) Shared Secret Key (Used to verify tokens with Verification Portal)
SSO_SHARED_SECRET=msc_prpcem_shared_sso_secret_2026

# API Key for Verification Portal to query student badges & certificates by email
QUIZ_PLATFORM_API_KEY=your_secure_quiz_platform_api_key_2026

# Verification Portal API Key & Base URL (For issuing certificates & badges)
VERIFICATION_PORTAL_URL=https://verify.mscprpcem.tech
VERIFICATION_API_KEY=your_secure_verification_api_key_2026

# Initial Seed Admin Account (Initialized if admin table is empty)
ADMIN_EMAIL=admin@mscprpcem.tech
ADMIN_PASSWORD=YourSecureAdminPassword123!
ADMIN_NAME=MSC Admin

# Allowed CORS Origins (Comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://quiz.mscprpcem.tech,https://verify.mscprpcem.tech


# 2. Frontend Configuration (frontend/.env)
VITE_API_URL=http://localhost:5000
VITE_VERIFICATION_PORTAL_URL=https://verify.mscprpcem.tech

