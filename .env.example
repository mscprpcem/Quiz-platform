# =====================================================================
# MSC QUIZ PLATFORM & VERIFICATION PORTAL CROSS-SYNC ENV VARIABLES
# =====================================================================

# 1. Backend Server Configuration (backend/.env)
PORT=5000
NODE_ENV=production

# Verification Portal Base URL (Used for linking student certificates & badges)
VERIFICATION_PORTAL_URL=https://verify.mscprpcem.tech

# SSO Shared Secret Key (Used to verify Single Sign-On JWT tokens between portals)
SSO_SHARED_SECRET=msc_prpcem_shared_sso_secret_2026

# JWT Secret for local quiz platform sessions
JWT_SECRET=msc_prpcem_jwt_secret_2026

# API Key for Verification Portal to query student badges & certificates by email
QUIZ_PLATFORM_API_KEY=msc_quiz_api_key_2026

# Allowed CORS Origins (Comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://quiz.mscprpcem.tech,https://verify.mscprpcem.tech


# 2. Frontend Configuration (frontend/.env)
VITE_API_BASE_URL=http://localhost:5000
VITE_VERIFICATION_PORTAL_URL=https://verify.mscprpcem.tech
